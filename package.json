{
  "name": "@desaubv/quik",
  "version": "0.0.4",
  "description": "Quik is an Express-based library designed to simplify the creation of modern backends. It allows you to build APIs quickly, reducing repetitive code through clean syntax and intuitive tools.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "quik",
    "typescript",
    "nodejs",
    "express",
    "router",
    "middleware",
    "typescript",
    "backend"
  ],
  "author": "desaubv",
  "homepage": "https://github.com/DiegoBarajas/quik",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoBarajas/quik.git"
  },
  "bugs": {
    "url": "https://github.com/DiegoBarajas/quik/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}